<Project>
    <PropertyGroup>
        <BuildScriptsRoot>$(MSBuildThisFileDirectory)</BuildScriptsRoot>
        <!--
            Dovetail would generate a joint that requires appsettings.yaml in the output folder under the project's name (Build.cs.yaml),
            which a file-based app does not copy there. The library's BuildScriptsRootJoint reads build/appsettings*.yaml in place instead.
        -->
        <DovetailEnableYamlConfiguration>false</DovetailEnableYamlConfiguration>
    </PropertyGroup>
    <ItemGroup>
        <ProjectProperty Include="BuildScriptsRoot" />
    </ItemGroup>
</Project>
