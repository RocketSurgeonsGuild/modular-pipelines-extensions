<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackTestShardGenerator</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <ItemGroup>
        <!-- Built first and packed as an analyzer; the library itself does not reference it. -->
        <ProjectReference
            Include="../ModularPipelines.Extensions.Analyzers/Rocket.Surgery.ModularPipelines.Extensions.Analyzers.csproj"
            ReferenceOutputAssembly="false"
            PrivateAssets="all"
        />
        <None Include="build/Rocket.Surgery.ModularPipelines.Extensions.props" Pack="true" PackagePath="build;buildTransitive" />
        <InternalsVisibleTo Include="Rocket.Surgery.ModularPipelines.Extensions.Tests" />
    </ItemGroup>

    <Target Name="PackTestShardGenerator">
        <MSBuild
            Projects="../ModularPipelines.Extensions.Analyzers/Rocket.Surgery.ModularPipelines.Extensions.Analyzers.csproj"
            Targets="GetTargetPath"
            Properties="Configuration=$(Configuration)"
        >
            <Output TaskParameter="TargetOutputs" ItemName="TestShardGeneratorAssembly" />
        </MSBuild>
        <ItemGroup>
            <TfmSpecificPackageFile Include="@(TestShardGeneratorAssembly)" PackagePath="analyzers/dotnet/cs" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <PackageReference Include="GitignoreParserNet" />
        <PackageReference Include="Humanizer.Core" />
        <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" />
        <PackageReference Include="ModelingEvolution.JsonParsableConverter" />
        <PackageReference Include="ModularPipelines" />
        <PackageReference Include="ModularPipelines.DotNet" />
        <PackageReference Include="ModularPipelines.Git" />
        <PackageReference Include="ProtoPromise" />
        <PackageReference Include="MSBuild.StructuredLogger" />
        <PackageReference Include="Riok.Mapperly" />
        <PackageReference Include="Joinery.Dovetail.ModularPipelines" />
        <PackageReference Include="Joinery.Dovetail.Configuration.Json" />
        <PackageReference Include="Joinery.Dovetail.Configuration.Yaml" />
        <PackageReference Include="Specular" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="default.runsettings" />
        <Using Include="ModularPipelines" />
        <Using Include="ModularPipelines.Attributes" />
        <Using Include="ModularPipelines.Context" />
        <Using Include="ModularPipelines.DotNet.Options" />
        <Using Include="ModularPipelines.DotNet.Services" />
        <Using Include="ModularPipelines.FileSystem" />
    </ItemGroup>
</Project>
