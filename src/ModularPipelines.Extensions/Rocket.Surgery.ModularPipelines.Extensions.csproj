<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <!-- RunHistoryJoint binds the History section while the pipeline is set up; the generator keeps that bind reflection free. -->
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="GitignoreParserNet" />
        <PackageReference Include="Humanizer.Core" />
        <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" />
        <PackageReference Include="ModelingEvolution.JsonParsableConverter" />
        <PackageReference Include="ModularPipelines" />
        <PackageReference Include="ModularPipelines.DotNet" />
        <PackageReference Include="ModularPipelines.Git" />
        <PackageReference Include="MSBuild.StructuredLogger" />
        <PackageReference Include="Riok.Mapperly" />
        <PackageReference Include="Joinery.Dovetail.ModularPipelines" />
        <PackageReference Include="Joinery.Dovetail.Configuration.Json" />
        <PackageReference Include="Joinery.Dovetail.Configuration.Yaml" />
        <PackageReference Include="Specular" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Rocket.Surgery.ModularPipelines.Extensions.Tests" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="default.runsettings" />
        <Using Include="ModularPipelines" />
        <Using Include="ModularPipelines.Attributes" />
        <Using Include="ModularPipelines.Context" />
        <Using Include="ModularPipelines.DotNet.Options" />
        <Using Include="ModularPipelines.DotNet.Services" />
        <Using Include="ModularPipelines.FileSystem" />
    </ItemGroup>
</Project>
