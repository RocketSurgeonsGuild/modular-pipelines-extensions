<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <ImplicitUsings>disable</ImplicitUsings>
        <IncludeBuildOutput>false</IncludeBuildOutput>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <!-- The repository-wide usings name types netstandard2.0 does not have. -->
        <Using Remove="System.Diagnostics.CodeAnalysis" />
        <Using Remove="System.Diagnostics.CodeAnalysis.NotNullAttribute" />
        <Using Remove="JetBrains.Annotations" />
        <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
        <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
        <InternalsVisibleTo Include="Rocket.Surgery.ModularPipelines.Extensions.Tests" />
    </ItemGroup>
</Project>
