<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <GlobalPackageReference Include="Rocket.Surgery.AssemblyInfo" Version="2026.11.5" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="GitignoreParserNet" Version="0.2.0.15" />
    <PackageVersion Include="Optionary" Version="0.1.1" />
    <PackageVersion Include="Sourcy.DotNet" Version="1.1.1" />
    <PackageVersion Include="Sourcy.Git" Version="1.1.1" />
    <PackageVersion Include="Humanizer.Core" Version="3.0.10" />
    <!-- Matches the Microsoft.CodeAnalysis.Analyzers GlobalPackageReference (5.3.0); newer Roslyn requires newer analyzers. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.3.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.15" />
    <PackageVersion Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
    <PackageVersion Include="MSBuild.StructuredLogger" Version="2.3.269" />
    <PackageVersion Include="Riok.Mapperly" Version="4.3.1" />
    <PackageVersion Include="ModularPipelines" Version="4.0.0" />
    <PackageVersion Include="ModularPipelines.DotNet" Version="4.0.0" />
    <PackageVersion Include="ModularPipelines.Git" Version="4.0.0" />
    <PackageVersion Include="ModelingEvolution.JsonParsableConverter" Version="1.0.1" />
    <PackageVersion Include="Joinery.Dovetail.Configuration.Json" Version="0.7.1" />
    <PackageVersion Include="Joinery.Dovetail.Configuration.Yaml" Version="0.7.1" />
    <PackageVersion Include="Joinery.Dovetail.ModularPipelines" Version="0.7.1" />
    <PackageVersion Include="Specular" Version="0.4.1" />
    <PackageVersion Include="TUnit" Version="1.87.0" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)/Directory.Packages.support.props" Condition="Exists('$(MSBuildThisFileDirectory)/Directory.Packages.support.props')" />
</Project>